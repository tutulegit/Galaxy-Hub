-- ============== SISTEMA AIMBOT ==============
local function getClosestPlayer()
    local closest = nil
    local shortestDistance = Settings.Aimbot.FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild(Settings.Aimbot.AimPart) then
                if Settings.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then
                    continue
                end
                
                local target = char[Settings.Aimbot.AimPart]
                local screenPos, onScreen = Camera:WorldToViewportPoint(target.Position)
                
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    
                    if distance <= Settings.Aimbot.FOV then
                        if Settings.Aimbot.VisibleCheck then
                            local ray = Ray.new(Camera.CFrame.Position, (target.Position - Camera.CFrame.Position).Unit * 500)
                            local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
                            if hit and hit:IsDescendantOf(char) == false then
                                continue
                            end
                        end
                        
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closest = player
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

-- ============== LOOP PRINCIPAL ==============
RunService.RenderStepped:Connect(function()
    -- Atualizar FOV Circle
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = Settings.Aimbot.FOVCircleVisible and Settings.Aimbot.Enabled
    
    -- Aimbot
    if Settings.Aimbot.Enabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(Settings.Aimbot.AimPart)
            if aimPart then
                local targetPos = aimPart.Position
                if Settings.Aimbot.Smoothness > 1 then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), 1 / Settings.Aimbot.Smoothness)
                else
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                end
            end
        end
    end
    
    -- FOV
    if Camera.FieldOfView ~= Settings.FOV.Value then
        Camera.FieldOfView = Settings.FOV.Value
    end
end)

-- ============== SISTEMA ESP CORRIGIDO ==============
local ESPObjects = {}

local function createESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not ESPObjects[player] then
            local drawings = {}
            
            drawings.Box = Drawing.new("Square")
            drawings.Box.Visible = false
            drawings.Box.Thickness = 2
            drawings.Box.Filled = false
            drawings.Box.Color = Color3.fromRGB(180, 100, 255)
            
            drawings.BoxOutline = Drawing.new("Square")
            drawings.BoxOutline.Visible = false
            drawings.BoxOutline.Thickness = 4
            drawings.BoxOutline.Filled = false
            drawings.BoxOutline.Color = Color3.fromRGB(0, 0, 0)
            
            drawings.Tracer = Drawing.new("Line")
            drawings.Tracer.Visible = false
            drawings.Tracer.Thickness = 1.5
            drawings.Tracer.Color = Color3.fromRGB(180, 100, 255)
            
            drawings.Distance = Drawing.new("Text")
            drawings.Distance.Visible = false
            drawings.Distance.Size = 15
            drawings.Distance.Center = true
            drawings.Distance.Outline = true
            drawings.Distance.Color = Color3.fromRGB(255, 255, 255)
            
            drawings.HealthBg = Drawing.new("Square")
            drawings.HealthBg.Visible = false
            drawings.HealthBg.Filled = true
            drawings.HealthBg.Color = Color3.fromRGB(30, 30, 30)
            
            drawings.HealthBar = Drawing.new("Square")
            drawings.HealthBar.Visible = false
            drawings.HealthBar.Filled = true
            drawings.HealthBar.Color = Color3.fromRGB(0, 255, 100)
            
            drawings.Name = Drawing.new("Text")
            drawings.Name.Visible = false
            drawings.Name.Size = 14
            drawings.Name.Center = true
            drawings.Name.Outline = true
            drawings.Name.Color = Color3.fromRGB(180, 100, 255)
            
            ESPObjects[player] = drawings
        end
    end
end

local function updateESP()
    for player, drawings in pairs(ESPObjects) do
        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        
        if char and humanoid and root and head and humanoid.Health > 0 then
            local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            local rootPos = Camera:WorldToViewportPoint(root.Position)
            
            if onScreen then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local distance = myRoot and (myRoot.Position - root.Position).Magnitude or 0
                
                if distance <= Settings.ESP.MaxDistance then
                    -- TAMANHO FIXO DA CAIXA (não escala com distância)
                    local boxWidth = 40
                    local boxHeight = 60
                    
                    -- Box
                    if Settings.ESP.Boxes then
                        drawings.BoxOutline.Visible = true
                        drawings.BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
                        drawings.BoxOutline.Position = Vector2.new(headPos.X - boxWidth/2, headPos.Y - boxHeight/2)
                        
                        drawings.Box.Visible = true
                        drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
                        drawings.Box.Position = Vector2.new(headPos.X - boxWidth/2, headPos.Y - boxHeight/2)
                    else
                        drawings.Box.Visible = false
                        drawings.BoxOutline.Visible = false
                    end
                    
                    -- Tracer
                    if Settings.ESP.Tracers then
                        drawings.Tracer.Visible = true
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(headPos.X, headPos.Y + boxHeight/2)
                    else
                        drawings.Tracer.Visible = false
                    end
                    
                    -- Distance
                    if Settings.ESP.Distance then
                        drawings.Distance.Visible = true
                        drawings.Distance.Text = math.floor(distance).."m"
                        drawings.Distance.Position = Vector2.new(headPos.X, headPos.Y + boxHeight/2 + 15)
                    else
                        drawings.Distance.Visible = false
                    end
                    
                    -- Health Bar
                    if Settings.ESP.HealthBar then
                        local healthPercent = humanoid.Health / humanoid.MaxHealth
                        local barWidth = 3
                        
                        drawings.HealthBg.Visible = true
                        drawings.HealthBg.Size = Vector2.new(barWidth, boxHeight)
                        drawings.HealthBg.Position = Vector2.new(headPos.X - boxWidth/2 - 5, headPos.Y - boxHeight/2)
                        
                        drawings.HealthBar.Visible = true
                        drawings.HealthBar.Size = Vector2.new(barWidth, boxHeight * healthPercent)
                        drawings.HealthBar.Position = Vector2.new(headPos.X - boxWidth/2 - 5, headPos.Y + boxHeight/2 - (boxHeight * healthPercent))
                        
                        if healthPercent > 0.6 then
                            drawings.HealthBar.Color = Color3.fromRGB(0, 255, 100)
                        elseif healthPercent > 0.3 then
                            drawings.HealthBar.Color = Color3.fromRGB(255, 200, 0)
                        else
                            drawings.HealthBar.Color = Color3.fromRGB(255, 50, 50)
                        end
                    else
                        drawings.HealthBg.Visible = false
                        drawings.HealthBar.Visible = false
                    end
                    
                    -- Name
                    if Settings.ESP.Names then
                        drawings.Name.Visible = true
                        drawings.Name.Text = player.Name
                        drawings.Name.Position = Vector2.new(headPos.X, headPos.Y - boxHeight/2 - 15)
                    else
                        drawings.Name.Visible = false
                    end
                else
                    for _, d in pairs(drawings) do
                        d.Visible = false
                    end
                end
            else
                for _, d in pairs(drawings) do
                    d.Visible = false
                end
            end
        else
            for _, d in pairs(drawings) do
                d.Visible = false
            end
        end
    end
end

-- Loop ESP
RunService.RenderStepped:Connect(function()
    if Settings.ESP.Enabled then
        createESP()
        updateESP()
    else
        for player, drawings in pairs(ESPObjects) do
            for _, d in pairs(drawings) do
                d:Remove()
            end
        end
        ESPObjects = {}
    end
end)

-- Limpeza
Players.PlayerRemoving:Connect(function(player)
    if ESPObjects[player] then
        for _, d in pairs(ESPObjects[player]) do
            d:Remove()
        end
        ESPObjects[player] = nil
    end
end)

